# Database (SQLite by default — no Docker needed; switch to PG for production)
DATABASE_URL=sqlite:./data/flyff.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyff

# Login Server
LOGIN_SERVER_PORT=28000
LOGIN_SERVER_SECRET=change-me-in-production

# Game Server
GAME_SERVER_PORT=2000
GAME_SERVER_SECRET=change-me-in-production

# Client (Vite reads VITE_ prefixed vars at build time)
VITE_LOGIN_SERVER_URL=ws://localhost:28000
VITE_GAME_SERVER_URL=ws://localhost:2000

# Original Flyff v15 asset paths (see docs/ASSET_SETUP.md)
RESOURCE_DIR=/path/to/flyff/v15/Server/Resource
CLIENT_DIR=/path/to/flyff/v15/Client
